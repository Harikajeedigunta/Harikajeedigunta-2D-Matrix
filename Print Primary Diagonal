#include<iostream>
#include<vector>
using namespace std;
void printPrimaryDiagonal(vector<vector<int>>& nums)
{
    int rows=nums.size();
    for(int i=0;i<rows;i++)
    {
        cout<<nums[i][i]<<" ";
    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printPrimaryDiagonal(nums);
}

