#include<iostream>
#include<algorithm>
#include<vector>
using namespace std;
void roate90Clockwise(vector<vector<int>>& nums)
{
    if(nums.empty() || nums[0].empty()) return;
    int n=nums.size();
    // Tranpose of a matrix
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            swap(nums[i][j],nums[j][i]);
        }
    }
    // Reverse each row
    for(int i=0;i<n;i++)
    {
        int left=0,right=n-1;
        while(left<right)
        {
            swap(nums[i][left],nums[i][right]);
            left++;
            right--;
        }
    }
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            cout<<nums[i][j]<<" ";
        }
        cout<<endl;
    }
}
int main()
{
    int n;
    cin>>n;
    vector<vector<int>>nums(n,vector<int>(n));
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            cin>>nums[i][j];      
        }
    }
    roate90Clockwise(nums);
}

