#include<bits/stdc++.h>
using namespace std;
void printRotate90(vector<vector<int>>& matrix)
{
    int n=matrix.size();
    // Transpose of matrix
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            swap(matrix[i][j],matrix[j][i]);
        }
    }
    // Reverse the matrix
    for(int i=0;i<n;i++)
    {
        reverse(matrix[i].begin(),matrix[i].end());
    }
}
int main() {
    vector<vector<int>> matrix = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    printRotate90(matrix);

    for (auto row : matrix) {
        for (int val : row)
            cout << val << " ";
        cout << endl;
    }
}

