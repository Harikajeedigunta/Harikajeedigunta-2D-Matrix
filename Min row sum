#include<iostream>
#include<climits>
#include<vector>
using namespace std;
pair<long long,int> minRowSum(vector<vector<int>>& nums)
{
    int rows=nums.size();
    int cols=nums[0].size();
    if(rows==0 || cols==0) return {-1,-1};
    long long min_row_sum=LLONG_MAX;
    int min_index=-1;
    for(int i=0;i<rows;i++)
    {
        long long row_sum=0;
        for(int j=0;j<cols;j++)
        {
            row_sum+=nums[i][j];
        }
        if(row_sum<min_row_sum)
        {
            min_row_sum=row_sum;
            min_index=i;// i+1 for 1-based indexing
        }
    }
    return {min_row_sum,min_index};
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    pair<long long,int>result=minRowSum(nums);
    cout<<result.first<<" "<<result.second;
}

