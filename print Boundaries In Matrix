#include<iostream>
#include<vector>
using namespace std;
void printBoundaries(vector<vector<int>>& nums)
{
    if(nums.empty() || nums[0].empty()) return;
    int rows=nums.size();
    int cols=nums[0].size();
    // If there is only one row
    if(rows==1)
    {
        for(int j=0;j<cols;j++)
        {
            cout<<nums[0][j]<<" ";
        }
        return;
    }
    // If there is only one column
    if(cols==1)
    {
        for(int i=0;i<rows;i++)
        {
            cout<<nums[i][0]<<" ";
        }
        return;
    }

    // Top row
    for(int j=0;j<cols;j++)
    {
        cout<<nums[0][j]<<" ";
    }
    // Right Column
    for(int i=1;i<rows;i++)
    {
        cout<<nums[i][cols-1]<<" ";
    }
    // Bottom row
    for(int j=cols-2;j>=0;j--)
    {
        cout<<nums[rows-1][j]<<" ";
    }
    // Left col
    for(int i=rows-2;i>0;i--)
    {
        cout<<nums[i][0]<<" ";
    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printBoundaries(nums);
}

