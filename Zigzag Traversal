#include<iostream>
#include<vector>
using namespace std;
void printZigzagTraversal(vector<vector<int>>& nums)
{
    if(nums.empty() || nums[0].empty()) return;
    int rows=nums.size();
    int cols=nums[0].size();
    for(int i=0;i<rows;i++)
    {
        if(i%2==0)
        {
            for(int j=0;j<cols;j++)
            {
                cout<<nums[i][j]<<" ";
            }
        }
        else
        {
            for(int j=cols-1;j>=0;j--)
            {
                cout<<nums[i][j]<<" ";
            }
        }
    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printZigzagTraversal(nums);
}

