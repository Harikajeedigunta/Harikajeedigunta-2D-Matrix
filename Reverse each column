#include<iostream>
#include<climits>
#include<algorithm>
#include<vector>
using namespace std;
void printreverseEachCol(vector<vector<int>>& nums)
{
    int rows=nums.size();
    int cols=nums[0].size();
    for(int i=0;i<rows/2;i++)
    {
        for(int j=0;j<cols;j++)
        {
            swap(nums[i][j],nums[rows-1-i][j]);
        }
    }
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cout<<nums[i][j]<<" ";
        }
        cout<<endl;
    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printreverseEachCol(nums);
}

