#include<iostream>
#include<climits>
#include<vector>
using namespace std;
int printMinEle(vector<vector<int>>& nums,int rows,int cols)
{
    int min_ele=INT_MAX;
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            if(nums[i][j]<min_ele)
            {
                min_ele=nums[i][j];
            }
        }
    }
    return min_ele;
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    cout<<printMinEle(nums,rows,cols);
}

