#include<iostream>
#include<vector>
using namespace std;
void spiralTraversal(vector<vector<int>>& nums)
{
    if(nums.empty() || nums[0].empty()) return;
    int top=0, bottom=nums.size()-1;
    int left=0,right=nums[0].size()-1;
    while(top<=bottom && left<=right)
    {
        // Top row
        for(int j=left;j<=right;j++)
        {
            cout<<nums[top][j]<<" ";
        }
        top++;
        // Right column
        for(int i=top;i<=bottom;i++)
        {
            cout<<nums[i][right]<<" ";
        }
        right--;
        // Bottom row
        if(top<=bottom)
        {
            for(int j=right;j>=left;j--)
            {
                cout<<nums[bottom][j]<<" ";
            }
            bottom--;
        }
        // Left column
        if(left<=right)
        {
            for(int i=bottom;i>=top;i--)
            {
                cout<<nums[i][left]<<" ";
            }
            left++;
        }

    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    spiralTraversal(nums);
}

