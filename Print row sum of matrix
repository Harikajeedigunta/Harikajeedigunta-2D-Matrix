#include<iostream>
#include<vector>
using namespace std;
void printRowSum(vector<vector<int>>nums,int rows,int cols)
{
    for(int i=0;i<rows;i++)
    {
        int row_sum=0;
        for(int j=0;j<cols;j++)
        {
            row_sum+=nums[i][j];
        }
        cout<<row_sum<<endl;
    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printRowSum(nums,rows,cols);
}

