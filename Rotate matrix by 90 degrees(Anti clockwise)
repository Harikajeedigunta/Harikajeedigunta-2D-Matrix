#include<bits/stdc++.h>
using namespace std;
void printRotate90(vector<vector<int>>& matrix)
{
    int n=matrix.size();
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            swap(matrix[i][j],matrix[j][i]);
        }
    }
    for(int j=0;j<n;j++)
    {
        int top=0,bottom=n-1;
        while(top<bottom)
        {
            swap(matrix[top][j],matrix[bottom][j]);
            top++;
            bottom--;
        }
    }
}
int main() {
    vector<vector<int>> matrix = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    printRotate90(matrix);

    for (auto row : matrix) {
        for (int val : row)
            cout << val << " ";
        cout << endl;
    }
}

