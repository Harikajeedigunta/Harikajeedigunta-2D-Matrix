#include<iostream>
#include<algorithm>
#include<vector>
using namespace std;
void rotate90AntiClockwise(vector<vector<int>>& nums)
{
    if(nums.empty() || nums[0].empty()) return;
    int n=nums.size();
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n;j++)
        {
            swap(nums[i][j],nums[j][i]);
        }
    }
    for(int j=0;j<n;j++)
    {
        int top=0,bottom=n-1;
        while(top<bottom)
        {
            swap(nums[top][j],nums[bottom][j]);
            top++;
            bottom--;
        }
    }
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            cout<<nums[i][j]<<" ";
        }
        cout<<endl;
    }
}
int main()
{
    int n;
    cin>>n;
    vector<vector<int>>nums(n,vector<int>(n));
    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            cin>>nums[i][j];
        }
    }
    rotate90AntiClockwise(nums);
}

