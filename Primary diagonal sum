#include<iostream>
#include<vector>
using namespace std;
int printPrimaryDiagonalSum(vector<vector<int>>& nums)
{
    int rows=nums.size();
    int cols=nums[0].size();
    int limit=min(rows,cols);
    int d1_sum=0;
    for(int i=0;i<limit;i++)
    {
        d1_sum+=nums[i][i];
    }
    return d1_sum;
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    cout<<printPrimaryDiagonalSum(nums);
}

