#include<iostream>
#include<vector>
using namespace std;
int countOfEvenNums(vector<vector<int>>& nums)
{
    if(nums.empty() || nums[0].empty()) return 0;
    int count=0;
    int rows=nums.size();
    int cols=nums[0].size();
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            if(nums[i][j]%2==0)
            {
                count++;
            }
        }
    }
    return count;
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    cout<<countOfEvenNums(nums);
}

