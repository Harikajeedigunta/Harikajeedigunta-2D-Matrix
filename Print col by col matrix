#include<iostream>
#include<vector>
using namespace std;
void printMatrix(vector<vector<int>>& nums,int rows,int cols)
{
   for(int j=0;j<cols;j++)
   {
       for(int i=0;i<rows;i++)
       {
           cout<<nums[i][j]<<" ";
       }
       cout<<endl;
   }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printMatrix(nums,rows,cols);
}

