#include<iostream>
#include<climits>
#include<vector>
using namespace std;
int printMaxEle(vector<vector<int>>nums,int rows,int cols)
{
    int max_ele=INT_MIN;
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            if(nums[i][j]>max_ele)
            {
                max_ele=nums[i][j];
            }
        }
    }
    return max_ele;
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    cout<<printMaxEle(nums,rows,cols);
}

