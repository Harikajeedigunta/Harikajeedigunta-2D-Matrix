#include<iostream>
#include<vector>
using namespace std;
void printColSum(vector<vector<int>>& nums,int rows,int cols)
{
    for(int j=0;j<cols;j++)
    {
        int col_sum=0;
        for(int i=0;i<rows;i++)
        {
            col_sum+=nums[i][j];
        }
        cout<<col_sum<<endl;
    }
}
int main()
{
    int rows,cols;
    cin>>rows>>cols;
    vector<vector<int>>nums(rows,vector<int>(cols));
    for(int i=0;i<rows;i++)
    {
        for(int j=0;j<cols;j++)
        {
            cin>>nums[i][j];
        }
    }
    printColSum(nums,rows,cols);
}

